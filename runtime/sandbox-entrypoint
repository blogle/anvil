#!/usr/bin/env bash
# Runtime bootstrap only: workspace is the persistent Sandbox PVC.
set -euo pipefail

: "${ANVIL_PROJECT:?ANVIL_PROJECT is required}"
: "${ANVIL_REPOSITORY:?ANVIL_REPOSITORY is required}"
: "${ANVIL_REF:?ANVIL_REF is required}"
: "${ANVIL_WORK_BRANCH:?ANVIL_WORK_BRANCH is required}"

export HOME=/workspace/home
project_dir="/workspace/${ANVIL_PROJECT}"
mkdir -p "$HOME"
profile_dir=/anvil/profile
mkdir -p "$profile_dir/config" "$profile_dir/auth" "$HOME/.local/share/opencode"
if [ ! -e "$profile_dir/config/opencode.jsonc" ]; then
  printf '{}\n' > "$profile_dir/config/opencode.jsonc"
fi
profile_auth="$profile_dir/auth/auth.json"
if [ ! -e "$profile_auth" ]; then
  (umask 077; : > "$profile_auth")
fi
chmod 600 "$profile_auth"
auth_link="$HOME/.local/share/opencode/auth.json"
if [ -L "$auth_link" ]; then
  if [ "$(readlink "$auth_link")" != "$profile_auth" ]; then
    ln -sfn "$profile_auth" "$auth_link"
  fi
elif [ ! -e "$auth_link" ]; then
  ln -s "$profile_auth" "$auth_link"
else
  echo "warning: preserving existing sandbox OpenCode auth.json" >&2
fi

if [ ! -d "$project_dir/.git" ]; then
  git clone --branch "$ANVIL_REF" --single-branch "$ANVIL_REPOSITORY" "$project_dir"
  git -C "$project_dir" switch -c "$ANVIL_WORK_BRANCH"
else
  git -C "$project_dir" switch "$ANVIL_WORK_BRANCH"
fi

cd "$project_dir"
exec opencode serve --hostname 0.0.0.0 --port 4096
