#!/usr/bin/env bash
# Runtime bootstrap only: /home/anvil is the persistent Sandbox PVC.
set -euo pipefail

if [ "$(id -u)" = 0 ] && [ "${1:-}" != --agent ]; then
  # A sandbox can be scheduled before the shared daemon finishes cold bootstrap.
  for _ in $(seq 1 300); do
    if [ -S /nix/var/nix/daemon-socket/socket ] &&
      setpriv --reuid=1000 --regid=1000 --init-groups -- nix store info >/dev/null 2>&1; then
      break
    fi
    sleep 1
  done
  setpriv --reuid=1000 --regid=1000 --init-groups -- nix store info >/dev/null
  exec setpriv --reuid=1000 --regid=1000 --init-groups -- "$0" --agent
fi

if [ "${1:-}" = --agent ]; then
  shift
fi

: "${ANVIL_PROJECT:?ANVIL_PROJECT is required}"
: "${ANVIL_REPOSITORY:?ANVIL_REPOSITORY is required}"
: "${ANVIL_REF:?ANVIL_REF is required}"
: "${ANVIL_WORK_BRANCH:?ANVIL_WORK_BRANCH is required}"

export HOME=/home/anvil
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-$XDG_STATE_HOME/runtime}"
export DISPLAY="${DISPLAY:-:99}"
project_dir="$HOME/workspace/${ANVIL_PROJECT}"

mkdir -p "$HOME" "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_DATA_HOME" \
  "$XDG_STATE_HOME" "$HOME/.local/share/opencode"
mkdir -p "$XDG_DATA_HOME/opencode" "$HOME/workspace"
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

if command -v Xvfb >/dev/null 2>&1 && ! pgrep -f "Xvfb ${DISPLAY}" >/dev/null 2>&1; then
  Xvfb "$DISPLAY" -screen 0 1280x1024x24 -nolisten tcp >/tmp/anvil-xvfb.log 2>&1 &
  xvfb_pid=$!
  trap 'kill "$xvfb_pid" 2>/dev/null || true' EXIT
fi

git config --global credential.helper /bin/anvil-credential
source /bin/anvil-git-identity

profile_dir=/anvil/profile
mkdir -p "$profile_dir/config" "$profile_dir/auth"
profile_auth="$profile_dir/auth/auth.json"
if [ ! -e "$profile_auth" ]; then
  (umask 077; : > "$profile_auth")
fi
chmod 600 "$profile_auth"
auth_link="$HOME/.local/share/opencode/auth.json"
if [ -L "$auth_link" ]; then
  if [ "$(readlink "$auth_link")" != "$profile_auth" ]; then
    ln -sfn "$profile_auth" "$auth_link"
  fi
elif [ ! -e "$auth_link" ]; then
  ln -s "$profile_auth" "$auth_link"
else
  echo "warning: preserving existing sandbox OpenCode auth.json" >&2
fi
data_auth_link="$XDG_DATA_HOME/opencode/auth.json"
if [ -L "$data_auth_link" ]; then
  if [ "$(readlink "$data_auth_link")" != "$profile_auth" ]; then
    ln -sfn "$profile_auth" "$data_auth_link"
  fi
elif [ ! -e "$data_auth_link" ]; then
  ln -s "$profile_auth" "$data_auth_link"
fi

git config --global --add safe.directory "$project_dir"
if [ ! -d "$project_dir/.git" ]; then
  git clone --branch "$ANVIL_REF" --single-branch "$ANVIL_REPOSITORY" "$project_dir"
  git -C "$project_dir" switch -c "$ANVIL_WORK_BRANCH"
elif [ "$(git -C "$project_dir" symbolic-ref --quiet --short HEAD 2>/dev/null || true)" != "$ANVIL_WORK_BRANCH" ]; then
  git -C "$project_dir" switch "$ANVIL_WORK_BRANCH"
fi

cd "$project_dir"
if [ -n "${ANVIL_SESSION_CREDENTIAL:-}" ]; then (
  while :; do
    branch="$(git branch --show-current 2>/dev/null || true)"
    if [ -n "$branch" ]; then
      payload="$(jq -cn --arg branch "$branch" '{branch:$branch}')"
    else
      payload='{"branch":null}'
    fi
    umask 077
    cfg="$(mktemp)"
    printf 'header = "Authorization: Bearer %s"\n' "$ANVIL_SESSION_CREDENTIAL" > "$cfg"
    curl --config "$cfg" --silent --max-time 10 --request POST \
      --header 'content-type: application/json' --data "$payload" \
      "${ANVIL_CREDENTIAL_URL%/}/v1/sessions/${ANVIL_SESSION_ID}/git-metadata" >/dev/null || true
    rm -f "$cfg"
    sleep 15
  done
) >/tmp/anvil-git-metadata.log 2>&1 &
fi
exec opencode serve --hostname 0.0.0.0 --port 4096
