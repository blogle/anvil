#!/usr/bin/env bash
set -euo pipefail

: "${ANVIL_SESSION_ID:?ANVIL_SESSION_ID is required}"
: "${ANVIL_CREDENTIAL_URL:?ANVIL_CREDENTIAL_URL is required}"
: "${ANVIL_SESSION_CREDENTIAL:?ANVIL_SESSION_CREDENTIAL is required}"

protocol=https
host=github.com
while IFS='=' read -r key value; do
  case "$key" in
    protocol) protocol="$value" ;;
    host) host="$value" ;;
  esac
done

if [ "$protocol" != https ] || [ "$host" != github.com ]; then
  echo "anvil-credential: only HTTPS github.com credentials are supported" >&2
  exit 1
fi

curl_config="$(mktemp)"
trap 'rm -f "$curl_config"' EXIT
(umask 077; printf 'header = "Authorization: Bearer %s"\nheader = "Accept: application/json"\n' \
  "$ANVIL_SESSION_CREDENTIAL" > "$curl_config")
response="$(${CURL:-curl} --config "$curl_config" --silent --show-error \
  --request POST \
  --header 'content-type: application/json' \
  --data '{"purpose":"git"}' \
  --write-out $'\n%{http_code}' \
  "${ANVIL_CREDENTIAL_URL%/}/v1/sessions/${ANVIL_SESSION_ID}/credentials/github")" || {
  echo "anvil-credential: broker request failed (no HTTP response)" >&2
  exit 1
}
http_status="${response##*$'\n'}"
response_body="${response%$'\n'*}"
if [[ "$http_status" != 2?? ]]; then
  error_code="$(printf '%s' "$response_body" | ${JQ:-jq} --raw-output '.error.code // empty' 2>/dev/null || true)"
  error_message="$(printf '%s' "$response_body" | ${JQ:-jq} --raw-output '.error.message // empty' 2>/dev/null || true)"
  upstream_status="$(printf '%s' "$response_body" | ${JQ:-jq} --raw-output '.error.upstream_status // empty' 2>/dev/null || true)"
  request_id="$(printf '%s' "$response_body" | ${JQ:-jq} --raw-output '.error.github_request_id // empty' 2>/dev/null || true)"
  detail="broker request failed (HTTP $http_status)"
  [ -n "$error_code" ] && detail="$detail: $error_code"
  [ -n "$error_message" ] && detail="$detail: $error_message"
  [ -n "$upstream_status" ] && detail="$detail (GitHub HTTP $upstream_status)"
  [ -n "$request_id" ] && detail="$detail [request $request_id]"
  echo "anvil-credential: $detail" >&2
  exit 1
fi
token="$(printf '%s' "$response_body" | ${JQ:-jq} --raw-output '.token // empty')"
if [ -z "$token" ]; then
  echo "anvil-credential: broker returned no GitHub token" >&2
  exit 1
fi

printf 'protocol=https\nhost=github.com\nusername=x-access-token\npassword=%s\n\n' "$token"
