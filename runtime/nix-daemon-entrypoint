#!/usr/bin/env bash
set -euo pipefail

if [ "${1:-}" = --bootstrap ]; then
  # The image's initialized DB and complete sandbox closure live in /nix;
  # mounting the PVC at /shared-nix leaves this baseline visible for import.
  state=/shared-nix/var/nix
  complete="$state/.anvil-bootstrap-complete"
  cold_attempt="$state/.anvil-cold-in-progress"
  staging_dir=/shared-nix/.anvil-import
  require_secure_build_state() {
    local path actual
    for path in /shared-nix /shared-nix/var "$state" "$state/builds"; do
      actual="$(stat -c '%u:%g:%a' "$path")"
      if [ "$actual" != 0:0:755 ]; then
        printf 'Nix PVC has unsafe build metadata: %s is %s (expected 0:0:755); run the documented one-time recovery before starting the daemon\n' \
          "$path" "$actual" >&2
        return 1
      fi
    done
  }
  umask 022
  mkdir -p /shared-nix/store /shared-nix/var "$state/builds"
  # Kind's local-path provisioner can create a world-writable volume root.
  # Secure only a truly uninitialized PVC; populated PVC metadata is checked,
  # never repaired as a side effect of an application restart.
  if [ ! -e "$complete" ] && [ ! -s "$state/db/db.sqlite" ]; then
    chmod 0755 /shared-nix
  fi
  require_secure_build_state
  # A previous init may have been interrupted while copying a store path.
  # This private staging area never contains authoritative store paths.
  rm -rf "$staging_dir"
  mkdir -p "$staging_dir"
  copy_baseline_paths() {
    for path in /nix/store/*; do
      name="${path##*/}"
      destination="/shared-nix/store/$name"
      if [ ! -e "$destination" ]; then
        cp -a "$path" "$staging_dir/$name"
        mv -T "$staging_dir/$name" "$destination"
      fi
    done
  }

  # On an interrupted first bootstrap, the only DB is the incomplete image
  # copy: the daemon has never started. Retain existing databases when there
  # is no cold-attempt marker (including populated PVCs from older releases).
  if [ -e "$cold_attempt" ] && [ ! -e "$complete" ]; then
    rm -rf "$state/db"
  fi
  if [ -e "$complete" ] && [ ! -s "$state/db/db.sqlite" ]; then
    echo 'Nix database missing from initialized shared store' >&2
    exit 1
  fi
  if [ ! -e "$state/db/db.sqlite" ]; then
    touch "$cold_attempt"
    copy_baseline_paths
    cp -a /nix/var/nix/. "$state/"
  else
    # Never replace the live DB or paths built by sandboxes. A pending dump
    # survives an interrupted import and is retried on the next startup.
    pending="$state/.anvil-baseline-pending"
    missing=0
    for path in /nix/store/*; do
      if [ ! -e "/shared-nix/store/${path##*/}" ]; then
        missing=1
        break
      fi
    done
    if [ "$missing" = 1 ] || [ -e "$pending" ]; then
      if [ "$missing" = 1 ]; then
        NIX_REMOTE=local nix-store --dump-db > "${pending}.tmp"
        mv "${pending}.tmp" "$pending"
      fi
      copy_baseline_paths
      NIX_REMOTE=local NIX_STATE_DIR="$state" nix-store --load-db < "$pending"
      rm "$pending"
    fi
  fi
  # Keep all baseline image paths alive, including the tools needed to start
  # future containers, even if other sandboxes run nix store gc.
  mkdir -p "$state/gcroots/anvil-baseline"
  for path in /nix/store/*; do
    name="${path##*/}"
    test -e "/shared-nix/store/$name"
    ln -sfn "/nix/store/$name" "$state/gcroots/anvil-baseline/$name"
  done
  test -s "$state/db/db.sqlite"
  touch "$complete"
  rm -f "$cold_attempt"
  rm -rf "$staging_dir"
  exit 0
fi

require_secure_build_state() {
  local path actual
  for path in /nix /nix/var /nix/var/nix /nix/var/nix/builds; do
    actual="$(stat -c '%u:%g:%a' "$path")"
    if [ "$actual" != 0:0:755 ]; then
      printf 'Nix PVC has unsafe build metadata: %s is %s (expected 0:0:755); refusing to repair shared state at daemon startup\n' \
        "$path" "$actual" >&2
      return 1
    fi
  done
}

umask 022
mkdir -p /nix/var /nix/var/nix /nix/var/nix/builds /nix/var/nix/daemon-socket
require_secure_build_state
rm -f /nix/var/nix/daemon-socket/socket
nix_daemon_pid=''
forward_signal() {
  if [ -n "$nix_daemon_pid" ]; then
    kill -TERM "$nix_daemon_pid" 2>/dev/null || true
  fi
}
trap forward_signal INT TERM
env -u NIX_REMOTE nix-daemon --daemon &
nix_daemon_pid=$!
for _ in {1..100}; do
  if [ -S /nix/var/nix/daemon-socket/socket ] && NIX_REMOTE=daemon nix store info >/dev/null 2>&1; then
    break
  fi
  if ! kill -0 "$nix_daemon_pid" 2>/dev/null; then
    wait "$nix_daemon_pid"
  fi
  sleep 0.1
done
require_secure_build_state
wait "$nix_daemon_pid"
