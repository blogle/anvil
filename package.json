{
  "name": "anvil-v2",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.5",
  "exports": {
    ".": "./src/application.ts"
  },
  "scripts": {
    "postinstall": "bun2nix -o bun.nix",
    "check": "bun run lock-check && bun run fmt:check && bun run typecheck && bun test",
    "fmt": "prettier --write 'src/**/*.ts' 'test/**/*.{ts,tsx}' 'scripts/**/*.ts' 'web/**/*.{ts,tsx,css,html}' package.json tsconfig.json",
    "fmt:check": "prettier --check 'src/**/*.ts' 'test/**/*.{ts,tsx}' 'scripts/**/*.ts' 'web/**/*.{ts,tsx,css,html}' package.json tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lock-check": "bash scripts/check-bun-lock-drift.sh",
    "start": "bun run src/main.ts",
    "ui:dev": "bun --bun vite --config web/vite.config.ts",
    "ui:build": "bun --bun vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@radix-ui/react-slot": "1.2.0",
    "@tanstack/react-query": "5.74.4",
    "@tanstack/react-router": "1.120.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "^4.13.14",
    "jose": "^6.2.13",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "3.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.3",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/bun": "1.2.5",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.4.1",
    "fast-check": "3.23.2",
    "happy-dom": "17.4.4",
    "prettier": "3.5.3",
    "tailwindcss": "4.1.3",
    "typescript": "5.8.3",
    "vite": "6.2.6"
  }
}
