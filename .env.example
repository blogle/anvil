# Anvil operator environment — copy to .env and fill in.
# .env is gitignored; the daemon loads it at boot.

# Required — `just keygen` writes this if absent.
# ANVIL_SECRET_KEY=

# GitHub App (github.com/settings/apps -> your app).
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# Path to the app's private key. ~ expands.
GITHUB_APP_PRIVATE_KEY_FILE=

# Optional — provider API keys as NAME=value pairs, whitespace-separated.
# PROVIDER_KEYS="OPENROUTER_API_KEY=sk-..."

# Optional — ChatGPT Plus OAuth. Run `opencode auth login` on the host first.
# OPENCODE_AUTH_JSON_FILE=~/.local/share/opencode/auth.json

# Local sandbox smoke: run `just sandbox-smoke`.
